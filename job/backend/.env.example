# Server
PORT=4000
NODE_ENV=development

# Postgres database for this service (all tables prefixed jobportal_)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobportal"
DB_SCHEMA=public
DB_SYNCHRONIZE=true

# Pavitram Central Auth API (third-party — signup/login happen here)
CENTRAL_AUTH_BASE_URL=https://mainbackend.pavitramindia.com/api/v1

# Local JWT — issued by THIS backend after verifying the user with Central Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
