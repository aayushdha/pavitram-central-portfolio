// ============================================================================
// Pavitram India — Prisma Schema
// Every table is prefixed with `main_` as requested.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum MainRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum MainAccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MainKycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum MainCommunityStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MainMessageStatus {
  NEW
  READ
  RESOLVED
}

enum MainSectionType {
  HERO
  RICH_TEXT
  ICON_CARDS
  STEP_LIST
  STATS
  CTA
  GALLERY
  CUSTOM
}

// ---------------------------------------------------------------------------
// Auth / Users
// ---------------------------------------------------------------------------

model MainUser {
  id             String              @id @default(cuid())
  name           String              @default("")
  email          String              @unique
  phone          String              @unique
  password       String
  role           MainRole            @default(USER)
  avatarUrl      String?
  accountStatus  MainAccountStatus   @default(ACTIVE)
  kycStatus      MainKycStatus       @default(PENDING)
  isOnboarded    Boolean             @default(false)
  address        String?
  city           String?
  state          String?
  profession     String?
  designation    String?
  organization   String?
  reference      String?
  lastLoginAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  reviewedCommunityMembers MainCommunityMember[] @relation("ReviewedBy")
  resolvedContactMessages  MainContactMessage[]  @relation("ResolvedBy")
  uploadedMedia            MainMedia[]
  auditLogs                MainAuditLog[]

  @@map("main_users")
}

// ---------------------------------------------------------------------------
// "Join the Community" submissions
// ---------------------------------------------------------------------------

model MainCommunityMember {
  id            String               @id @default(cuid())
  fullName      String
  mobileNumber  String
  profession    String
  designation   String
  organization  String
  location      String
  city          String
  state         String
  reference     String?
  status        MainCommunityStatus  @default(PENDING)
  reviewedById  String?
  reviewedBy    MainUser?            @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status])
  @@map("main_community_members")
}

// ---------------------------------------------------------------------------
// Contact form submissions
// ---------------------------------------------------------------------------

model MainContactMessage {
  id           String             @id @default(cuid())
  name         String
  contact      String
  subject      String
  message      String
  status       MainMessageStatus  @default(NEW)
  resolvedById String?
  resolvedBy   MainUser?          @relation("ResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status])
  @@map("main_contact_messages")
}

// ---------------------------------------------------------------------------
// Services (Pavitram Mart, Wellness, Gyan, ... ) — powers /services/* pages
// and the dashboard service grid.
// ---------------------------------------------------------------------------

model MainService {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  hindi                String
  tagline              String
  heroIcon             String   @default("Sparkles")
  aboutTitle           String
  aboutP1              String
  aboutP2              String
  pills                Json     @default("[]")
  whyUs                Json     @default("[]")
  features             Json     @default("[]")
  steps                Json     @default("[]")
  dashboardDescription String   @default("")
  dashboardHref        String   @default("")
  dashboardExternal    Boolean  @default(false)
  dashboardSso         Boolean  @default(false)
  dashboardAccent      String   @default("from-gold/20 to-transparent")
  showOnDashboard      Boolean  @default(true)
  metaDescription      String?
  order                Int      @default(0)
  isPublished          Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([order])
  @@map("main_services")
}

// ---------------------------------------------------------------------------
// Opportunities (Consumer / Merchant / Investor / Career)
// ---------------------------------------------------------------------------

model MainOpportunity {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  hindi           String
  label           String
  icon            String   @default("Sparkles")
  intro           String
  benefits        Json     @default("[]")
  steps           Json     @default("[]")
  metaDescription String?
  order           Int      @default(0)
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([order])
  @@map("main_opportunities")
}

// ---------------------------------------------------------------------------
// FAQs
// ---------------------------------------------------------------------------

model MainFaq {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String   @default("General")
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@map("main_faqs")
}

// ---------------------------------------------------------------------------
// Testimonials
// ---------------------------------------------------------------------------

model MainTestimonial {
  id          String   @id @default(cuid())
  name        String
  role        String?
  quote       String
  avatarUrl   String?
  rating      Int      @default(5)
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@map("main_testimonials")
}

// ---------------------------------------------------------------------------
// Team / Network members (About > Network)
// ---------------------------------------------------------------------------

model MainTeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String?
  bio         String?
  avatarUrl   String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@map("main_team_members")
}

// ---------------------------------------------------------------------------
// Impact stats (home page numbers e.g. "10,000+ Members")
// ---------------------------------------------------------------------------

model MainStat {
  id          String   @id @default(cuid())
  label       String
  value       String
  icon        String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@map("main_stats")
}

// ---------------------------------------------------------------------------
// Generic CMS: Pages -> Sections (About + sub-pages, Home narrative blocks,
// Contact / Join / FAQ intros, etc.) — every field editable from Super Admin.
// ---------------------------------------------------------------------------

model MainPage {
  id              String            @id @default(cuid())
  slug            String            @unique
  title           String
  hindi           String?
  subtitle        String?
  metaDescription String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  sections MainPageSection[]

  @@map("main_pages")
}

model MainPageSection {
  id          String          @id @default(cuid())
  pageId      String
  page        MainPage        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key         String
  type        MainSectionType @default(CUSTOM)
  title       String?
  hindi       String?
  subtitle    String?
  body        Json            @default("{}")
  order       Int             @default(0)
  isPublished Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([pageId, key])
  @@index([pageId, order])
  @@map("main_page_sections")
}

// ---------------------------------------------------------------------------
// Site-wide settings (logo, contact details, socials, footer text, ...)
// ---------------------------------------------------------------------------

model MainSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @default("")
  group     String   @default("general")
  label     String   @default("")
  type      String   @default("text") // text | textarea | image | url | boolean | json
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([group])
  @@map("main_settings")
}

// ---------------------------------------------------------------------------
// Media library (uploaded images used across the CMS)
// ---------------------------------------------------------------------------

model MainMedia {
  id           String   @id @default(cuid())
  url          String
  filename     String
  originalName String
  mimetype     String
  size         Int
  uploadedById String?
  uploadedBy   MainUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@map("main_media")
}

// ---------------------------------------------------------------------------
// Audit log — tracks super admin edits for accountability
// ---------------------------------------------------------------------------

model MainAuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  admin      MainUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminName  String   @default("")
  action     String
  entityType String
  entityId   String?
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("main_audit_logs")
}
