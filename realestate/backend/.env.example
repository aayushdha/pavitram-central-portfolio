# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma separated list of origins allowed to call this API from the browser
CORS_ORIGINS=http://localhost:3000,https://realestate.pavitramindia.com

# ----------------------------------------------------------------------------
# Database (all tables are created with a realnew_ prefix, see prisma/schema.prisma)
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pavitram_realestate?schema=public"

# ----------------------------------------------------------------------------
# Central Pavitram Auth API (mainbackend.pavitramindia.com)
# Signup / Signin / Password reset all happen on that service — this backend
# NEVER stores passwords, it only verifies the access_token the client
# already obtained from the central auth API.
# ----------------------------------------------------------------------------
CENTRAL_AUTH_BASE_URL=https://mainbackend.pavitramindia.com/api/v1
# How long (ms) a verified token result is cached locally before /auth/me is
# called again for the same token. Keeps latency down without giving stale
# suspended/expired tokens long-lived access.
CENTRAL_AUTH_CACHE_TTL_MS=60000

# Optional: internal service-to-service key if you ever add a private
# central-auth endpoint that requires it. Not required for /auth/me.
CENTRAL_AUTH_SERVICE_TOKEN=

# ----------------------------------------------------------------------------
# Public URL of THIS backend (used to build image URLs returned by /storage/upload)
# ----------------------------------------------------------------------------
BACKEND_PUBLIC_URL=http://localhost:4000

# ----------------------------------------------------------------------------
# MinIO (image storage for property/project photos)
# Reuses the SAME shared MinIO instance as the rest of the VPS — see
# DEPLOY_GUIDE.md "Create a separate MinIO bucket for real estate images".
# ----------------------------------------------------------------------------
MINIO_ENDPOINT=host.docker.internal
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=realestate
